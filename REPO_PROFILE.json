{
  "$schema": "./contracts/schemas/repo-profile.schema.json",
  "templateName": "Project Governance Scaffold",
  "purpose": "Reusable repo scaffold for contract-first, agent-friendly project setup.",
  "rootPolicy": {
    "keepAtRoot": [
      ".claude/",
      ".github/",
      ".gitignore",
      "AGENTS.md",
      "CHANGELOG.md",
      "CLI_INDEX.md",
      "CONTRIBUTING.md",
      "DECISIONS.md",
      "LOG.md",
      "REPO_PROFILE.json",
      "README.md",
      "ROADMAP.md",
      "contracts/",
      "docs/",
      "package.json",
      "package-lock.json",
      "packages/",
      "scripts/",
      "skills/",
      "template.vars.json",
      "tests/",
      "tsconfig.json",
      "vitest.config.ts"
    ],
    "rootDocsAllowed": [
      "CHANGELOG.md",
      "CLI_INDEX.md",
      "CONTRIBUTING.md",
      "DECISIONS.md",
      "LOG.md",
      "ROADMAP.md"
    ],
    "note": "Root stays limited to entrypoints, conventional project files, and major implementation/doc directories. REPO_PROFILE.json is the machine-readable taxonomy."
  },
  "canonicalPaths": {
    "contracts": "contracts/",
    "core": "packages/core/",
    "tests": "tests/",
    "docs": "docs/",
    "architecture": "docs/architecture/ARCHITECTURE.md",
    "repoBoundaries": "docs/architecture/REPO_BOUNDARIES.md",
    "roadmapIndex": "ROADMAP.md",
    "decisionsIndex": "DECISIONS.md",
    "workLog": "LOG.md",
    "cliIndex": "CLI_INDEX.md",
    "currentState": "docs/roadmaps/CURRENT_STATE_AND_NEXT.md",
    "compatibility": "docs/architecture/COMPATIBILITY.md",
    "decisionLogs": "docs/decisions/",
    "aiUsage": "docs/governance/AI_USAGE.md",
    "agentStart": "docs/agents/START_HERE.md",
    "agentRoleCatalog": "docs/agents/ROLE_CATALOG.md",
    "contextRouting": "docs/agents/CONTEXT_ROUTING.md",
    "agentRouting": "docs/agents/ROUTING.md",
    "agentGovernance": "contracts/agent-governance/",
    "assignmentEngineering": "docs/governance/ASSIGNMENT_ENGINEERING.md",
    "runtimeEvidence": "docs/governance/RUNTIME_EVIDENCE.md",
    "artifactTimeline": "docs/governance/ARTIFACT_TIMELINE_CONVENTION.md",
    "scaffoldDrift": "docs/governance/SCAFFOLD_DRIFT.md",
    "learningGuidance": "docs/governance/LEARNINGS.md",
    "templateUsage": "docs/project/TEMPLATE_USAGE.md",
    "newProjectChecklist": "docs/project/NEW_PROJECT_CHECKLIST.md",
    "skills": "skills/",
    "audits": "docs/audits/",
    "templates": "docs/templates/"
  },
  "commands": {
    "install": "npm run install:local",
    "initializeTemplate": "npm run init:template",
    "dryRunTemplateInitializer": "npm run init:template:dry-run",
    "validateScaffold": "npm run validate:scaffold",
    "validateContracts": "npm run validate:contracts",
    "validateAgents": "npm run validate:agents",
    "validateAssignment": "npm run validate:assignment",
    "adoptionCheck": "npm run scaffold:adoption-check",
    "memoryCheck": "npm run scaffold:memory-check",
    "generateAssignment": "npm run agent:assign",
    "initializeAgentRun": "npm run agent:run-init",
    "buildContextPack": "npm run agent:build-context",
    "checkContextPack": "npm run agent:check-context",
    "draftOrPromoteReceipt": "npm run agent:receipt",
    "writeReceipt": "npm run agent:write-receipt",
    "agentPreflight": "npm run agent:preflight",
    "agentStopVerify": "npm run agent:stop-verify",
    "manualAgentLoop": "npm run agent:run-loop",
    "focusedTests": "npm run test:focused",
    "governanceTests": "npm run test:governance",
    "securityTests": "npm run test:security",
    "allTests": "npm test",
    "typecheck": "npm run typecheck",
    "fullCheck": "npm run check"
  },
  "readFirst": [
    "AGENTS.md",
    "REPO_PROFILE.json",
    "CLI_INDEX.md",
    "docs/agents/START_HERE.md",
    "docs/project/TEMPLATE_USAGE.md",
    "docs/project/NEW_PROJECT_CHECKLIST.md",
    "contracts/README.md",
    "contracts/agent-governance/README.md",
    "docs/governance/AGENT_OPERATING_MODEL.md",
    "docs/agents/ROLE_CATALOG.md",
    "docs/agents/CONTEXT_ROUTING.md",
    "docs/governance/ASSIGNMENT_ENGINEERING.md",
    "docs/governance/RUNTIME_EVIDENCE.md",
    "docs/governance/ARTIFACT_TIMELINE_CONVENTION.md",
    "docs/governance/SCAFFOLD_DRIFT.md",
    "docs/governance/LEARNINGS.md",
    "docs/agents/ROUTING.md",
    "docs/architecture/ARCHITECTURE.md",
    "docs/architecture/REPO_BOUNDARIES.md",
    "docs/architecture/COMPATIBILITY.md",
    "packages/core/README.md",
    "tests/README.md",
    "ROADMAP.md",
    "DECISIONS.md",
    "docs/roadmaps/CURRENT_STATE_AND_NEXT.md"
  ],
  "governanceLocked": [
    "AGENTS.md",
    "docs/architecture/ARCHITECTURE.md",
    "docs/architecture/REPO_BOUNDARIES.md",
    "docs/governance/",
    "contracts/agent-governance/",
    "docs/repo-truth/",
    "REPO_PROFILE.json"
  ],
  "projectTraits": [
    "node",
    "github-actions",
    "agentic"
  ],
  "riskProfile": "standard",
  "agentGovernance": {
    "policy": "contracts/agent-governance/policy.json",
    "sourceAuthority": "contracts/agent-governance/source-authority.json",
    "router": "contracts/agent-governance/router.json",
    "defaultAssignment": "contracts/agent-governance/assignments/scoped-change.json",
    "defaultContextProfile": "contracts/agent-governance/context-profiles/scoped-change.json",
    "receiptPolicy": "contracts/agent-governance/receipt-policy.json",
    "defaultAutonomyLevel": "A1",
    "qualityProfiles": [
      "baseline",
      "node",
      "agentic"
    ],
    "runtimeAdapters": []
  },
  "downstreamScopes": [
    "adapters",
    "demos",
    "provider integrations",
    "deployment workflows",
    "UI/operator surfaces",
    "product-specific features"
  ],
  "forbiddenRootDirectoriesBeforeProjectAdoption": [
    "adapters",
    "demos",
    "providers",
    "runtime-adapters",
    "apps"
  ],
  "allowedTemplatePlaceholders": [
    "<PROJECT_NAME>",
    "<STATE_PROJECT_GOAL>",
    "<ONE_SENTENCE_THESIS>",
    "<OWNED_BOUNDARY>",
    "<IDENTITY_INTEGRATION>",
    "<DATA_OR_COMPUTE_INTEGRATION>",
    "<EXECUTION_INTEGRATION>",
    "<TOOL>",
    "<PURPOSE>",
    "<OWNER>",
    "<REVIEWER>",
    "<ONE_OR_TWO_SENTENCES>",
    "<PARTNER_1>",
    "<PARTNER_2>",
    "<PARTNER_3>",
    "<PROOF_1>",
    "<PROOF_2>",
    "<PROOF_3>",
    "<THE_ONE_SENTENCE_DEMO_CLOSE>",
    "<SUBMISSION_DEADLINE>",
    "<VIDEO_LENGTH_REQUIREMENT>",
    "<PARTNER_SELECTION_RULE>",
    "<HOW_THE_PROJECT_QUALIFIES>",
    "<EVIDENCE_1>",
    "<EVIDENCE_2>",
    "<FILE_OR_FOLDER>",
    "<ONE_SENTENCE_DESCRIPTION>",
    "<WHAT_PROBLEM_ARE_WE_SOLVING>",
    "<WHAT_ARE_WE_BUILDING>",
    "<USER_1>",
    "<USER_2>",
    "<MVP_REQUIREMENT_1>",
    "<MVP_REQUIREMENT_2>",
    "<MVP_REQUIREMENT_3>",
    "<NON_GOAL_1>",
    "<NON_GOAL_2>",
    "<SUCCESS_CRITERION_1>",
    "<SUCCESS_CRITERION_2>",
    "<WHAT_THIS_FEATURE_CREATES>",
    "<GOAL_1>",
    "<GOAL_2>",
    "<Feature Or Phase>",
    "<path>",
    "<exact command>",
    "<command>",
    "<result>",
    "<absolute repo path>",
    "<specific objective>",
    "<task-specific docs>"
  ],
  "qualityGate": [
    "npm run validate:scaffold",
    "npm run validate:contracts",
    "npm run validate:agents",
    "npm run validate:assignment",
    "npm run scaffold:adoption-check",
    "npm run scaffold:memory-check",
    "npm run test:focused",
    "npm run test:governance",
    "npm run test:security",
    "npm test",
    "npm run typecheck"
  ]
}
