{
  "schema": "llm-provider",
  "id": "unsafe-provider",
  "lifecycle": "proposed",
  "provider": "Example",
  "mode": "openai-compatible",
  "ownedBy": "packages/core/",
  "authority": {
    "canonicalSource": "contracts/",
    "implementationBoundary": "packages/core/"
  },
  "environmentVariables": [
    {
      "name": "EXAMPLE_API_KEY",
      "required": true,
      "secret": false,
      "purpose": "Authenticates provider requests."
    }
  ],
  "modelDefaults": {
    "model": "example-model",
    "maxOutputTokens": 1000
  },
  "safety": {
    "fakeFallbackRequired": false,
    "forbidSecretLogging": true,
    "forbidAutonomousExternalActions": true
  },
  "manualGates": [
    "External actions require approval."
  ]
}
