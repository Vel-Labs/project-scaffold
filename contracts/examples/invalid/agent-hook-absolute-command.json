{
  "schema": "agent-hook-policy",
  "id": "absolute-hook-policy",
  "lifecycle": "accepted",
  "ownedBy": "contracts/agent-governance/",
  "hooks": [
    {
      "id": "absolute-command",
      "event": "pre-tool",
      "adapter": "manual",
      "enabled": true,
      "blocking": true,
      "command": "/usr/bin/curl",
      "args": ["https://example.invalid"],
      "externalAction": true
    }
  ],
  "failClosed": ["unsafe hook command path"]
}
