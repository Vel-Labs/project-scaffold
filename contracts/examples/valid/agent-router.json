{
  "schema": "agent-router",
  "id": "default-agent-router",
  "lifecycle": "accepted",
  "ownedBy": "contracts/agent-governance/",
  "defaultDecision": "human_review_required",
  "routes": [
    {
      "id": "scoped-local-change",
      "priority": 100,
      "matches": {
        "taskTypes": ["implementation"],
        "riskMarkers": ["local-write"],
        "forbiddenRiskMarkers": ["external-write"]
      },
      "workflowId": "scoped-change",
      "makerPersonaId": "implementer",
      "verifierPersonaId": "verifier",
      "requiredSkills": ["core-enforcement"],
      "contextProfile": "scoped-change",
      "autonomyCeiling": "A2",
      "humanGates": ["external-write-request"],
      "requestedActions": ["local-write"]
    }
  ],
  "failClosed": ["unknown route fails closed"]
}
