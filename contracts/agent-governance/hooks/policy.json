{
  "schema": "agent-hook-policy",
  "id": "default-hook-policy",
  "lifecycle": "accepted",
  "ownedBy": "contracts/agent-governance/",
  "hooks": [
    {
      "id": "local-preflight",
      "event": "preflight",
      "adapter": "manual",
      "enabled": false,
      "blocking": true,
      "command": "npm",
      "args": ["run", "agent:preflight"],
      "externalAction": false
    },
    {
      "id": "validate-governance-on-stop",
      "event": "stop",
      "adapter": "manual",
      "enabled": false,
      "blocking": true,
      "command": "npm",
      "args": ["run", "agent:stop-verify"],
      "externalAction": false
    }
  ],
  "failClosed": [
    "unsafe hook command path",
    "hook attempts external action",
    "runtime adapter conflicts with canonical hook policy",
    "hook treated as sole enforcement boundary"
  ]
}
