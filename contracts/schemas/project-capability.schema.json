{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-governance-scaffold.local/schemas/project-capability.schema.json",
  "title": "ProjectCapability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "lifecycle",
    "summary",
    "ownedBy",
    "authority",
    "failClosed"
  ],
  "properties": {
    "schema": {
      "const": "project-capability"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "lifecycle": {
      "type": "string",
      "enum": ["draft", "proposed", "accepted", "active", "deprecated", "retired"]
    },
    "summary": {
      "type": "string",
      "minLength": 12
    },
    "ownedBy": {
      "type": "string",
      "minLength": 3
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalSource", "implementationBoundary"],
      "properties": {
        "canonicalSource": {
          "const": "contracts/"
        },
        "implementationBoundary": {
          "const": "packages/core/"
        }
      }
    },
    "failClosed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    }
  }
}
