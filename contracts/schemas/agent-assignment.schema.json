{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-governance-scaffold.local/schemas/agent-assignment.schema.json",
  "title": "AgentAssignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "lifecycle",
    "ownedBy",
    "taskType",
    "owner",
    "reviewer",
    "summary",
    "risk",
    "routeId",
    "workflowId",
    "makerPersonaId",
    "verifierPersonaId",
    "autonomyLevel",
    "allowedPaths",
    "forbiddenPaths",
    "doNotTouchPaths",
    "dependencies",
    "blockedBy",
    "requestedActions",
    "expectedChecks",
    "humanApprovals",
    "receiptRequired"
  ],
  "properties": {
    "schema": { "const": "agent-assignment" },
    "id": { "$ref": "#/$defs/kebabId" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "ownedBy": { "type": "string", "minLength": 3 },
    "taskType": { "enum": ["implementation", "docs", "test", "refactor", "content", "research", "quality"] },
    "owner": { "type": "string", "minLength": 3 },
    "reviewer": { "type": "string", "minLength": 3 },
    "summary": { "type": "string", "minLength": 12 },
    "risk": { "$ref": "#/$defs/risk" },
    "routeId": { "$ref": "#/$defs/kebabId" },
    "workflowId": { "$ref": "#/$defs/kebabId" },
    "makerPersonaId": { "$ref": "#/$defs/kebabId" },
    "verifierPersonaId": { "$ref": "#/$defs/kebabId" },
    "autonomyLevel": { "$ref": "#/$defs/autonomy" },
    "allowedPaths": { "$ref": "#/$defs/pathList" },
    "forbiddenPaths": { "$ref": "#/$defs/pathList" },
    "doNotTouchPaths": { "$ref": "#/$defs/pathList" },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blockedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requestedActions": { "$ref": "#/$defs/stringList" },
    "expectedChecks": { "$ref": "#/$defs/stringList" },
    "humanApprovals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "required", "status"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "enum": ["not-required", "required-not-granted", "granted"] }
        }
      }
    },
    "receiptRequired": { "const": true }
  },
  "$defs": {
    "autonomy": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4"] },
    "kebabId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "lifecycle": { "type": "string", "enum": ["draft", "proposed", "accepted", "active", "deprecated", "retired"] },
    "pathList": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "stringList": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
