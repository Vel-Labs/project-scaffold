{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-governance-scaffold.local/schemas/llm-provider.schema.json",
  "title": "LlmProvider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "lifecycle",
    "provider",
    "mode",
    "ownedBy",
    "authority",
    "environmentVariables",
    "modelDefaults",
    "safety",
    "manualGates"
  ],
  "properties": {
    "schema": {
      "const": "llm-provider"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "lifecycle": {
      "type": "string",
      "enum": ["draft", "proposed", "accepted", "active", "deprecated", "retired"]
    },
    "provider": {
      "type": "string",
      "minLength": 2
    },
    "mode": {
      "type": "string",
      "enum": ["fake", "anthropic-compatible", "openai-compatible", "local"]
    },
    "ownedBy": {
      "type": "string",
      "minLength": 3
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalSource", "implementationBoundary"],
      "properties": {
        "canonicalSource": {
          "const": "contracts/"
        },
        "implementationBoundary": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "environmentVariables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "secret", "purpose"],
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "(API_KEY|TOKEN|SECRET|PASSWORD)$"
                }
              },
              "required": ["name"]
            },
            "then": {
              "properties": {
                "secret": {
                  "const": true
                }
              }
            }
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "modelDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "maxOutputTokens"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 2
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "contextWindowTokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fakeFallbackRequired", "forbidSecretLogging", "forbidAutonomousExternalActions"],
      "properties": {
        "fakeFallbackRequired": {
          "const": true
        },
        "forbidSecretLogging": {
          "const": true
        },
        "forbidAutonomousExternalActions": {
          "const": true
        }
      }
    },
    "manualGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    }
  }
}
