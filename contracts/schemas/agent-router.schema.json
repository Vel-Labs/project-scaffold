{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-governance-scaffold.local/schemas/agent-router.schema.json",
  "title": "AgentRouter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "lifecycle", "ownedBy", "defaultDecision", "routes", "failClosed"],
  "properties": {
    "schema": { "const": "agent-router" },
    "id": { "$ref": "#/$defs/kebabId" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "ownedBy": { "type": "string", "minLength": 3 },
    "defaultDecision": { "enum": ["human_review_required", "blocked"] },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "matches",
          "workflowId",
          "makerPersonaId",
          "verifierPersonaId",
          "requiredSkills",
          "contextProfile",
          "autonomyCeiling",
          "humanGates",
          "requestedActions"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/kebabId" },
          "priority": { "type": "integer", "minimum": 1 },
          "matches": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskTypes", "riskMarkers", "forbiddenRiskMarkers"],
            "properties": {
              "taskTypes": { "$ref": "#/$defs/stringList" },
              "riskMarkers": { "$ref": "#/$defs/stringList" },
              "forbiddenRiskMarkers": { "$ref": "#/$defs/stringList" }
            }
          },
          "workflowId": { "$ref": "#/$defs/kebabId" },
          "makerPersonaId": { "$ref": "#/$defs/kebabId" },
          "verifierPersonaId": { "$ref": "#/$defs/kebabId" },
          "requiredSkills": { "$ref": "#/$defs/stringList" },
          "contextProfile": { "$ref": "#/$defs/kebabId" },
          "autonomyCeiling": { "$ref": "#/$defs/autonomy" },
          "humanGates": { "$ref": "#/$defs/stringList" },
          "requestedActions": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "failClosed": { "$ref": "#/$defs/stringList" }
  },
  "$defs": {
    "autonomy": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4"] },
    "kebabId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "lifecycle": { "type": "string", "enum": ["draft", "proposed", "accepted", "active", "deprecated", "retired"] },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
